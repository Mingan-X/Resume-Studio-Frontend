map $uri $frontend_cache {
    default "no-cache";
    ~^/assets/ "public, max-age=31536000, immutable";
    ~^/api/ "no-store";
}
server {
    listen 80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    server_name ${PUBLIC_HOST};
    return 308 https://${PUBLIC_HOST}$request_uri;
}
server {
    listen 443 ssl;
    server_name ${PUBLIC_HOST};
    if ($host != "${PUBLIC_HOST}") { return 444; }
    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /srv/www;
    client_max_body_size 11m;
    client_body_timeout 30s;
    add_header Strict-Transport-Security "max-age=31536000" always;
    include /etc/nginx/resume/security-headers.conf;
    include /etc/nginx/resume/locations.conf;
}
