{
  "name": "resume-studio-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0 && prettier . --check",
    "format": "prettier . --write",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=ui",
    "test:smoke": "playwright test --project=real"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.108.4",
    "vue": "3.5.46",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.2",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.15.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-vue": "10.12.1",
    "happy-dom": "21.0.4",
    "msw": "3.0.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "vue-tsc": "3.3.14"
  },
  "msw": {
    "workerDirectory": [
      "tests\\mocks\\public"
    ]
  }
}
